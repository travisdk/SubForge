# Writes OUTPUT with SUBFORGE_VERSION_STRING set to "git describe --tags --dirty"
# without the leading "v" (e.g. 1.0.1, 1.0.1-2-g945938c, 1.0.1-dirty), or to
# FALLBACK when git or the tags are missing (e.g. a build from a zip).
# Run as a script at every build:
#   cmake -DSOURCE_DIR=... -DOUTPUT=... -DFALLBACK=... [-DGIT_EXECUTABLE=...] -P GitVersion.cmake
# The file is only rewritten when the version changed, so nothing rebuilds needlessly.

set(version "${FALLBACK}")
if (GIT_EXECUTABLE)
    execute_process(COMMAND "${GIT_EXECUTABLE}" describe --tags --dirty
                    WORKING_DIRECTORY "${SOURCE_DIR}"
                    RESULT_VARIABLE result
                    OUTPUT_VARIABLE described
                    OUTPUT_STRIP_TRAILING_WHITESPACE
                    ERROR_QUIET)
    if (result EQUAL 0 AND described)
        string(REGEX REPLACE "^v" "" version "${described}")
    endif()
endif()

set(content "// Generated by cmake/GitVersion.cmake - do not edit.\n#pragma once\n#define SUBFORGE_VERSION_STRING \"${version}\"\n")
if (EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
endif()
if (NOT content STREQUAL previous)
    file(WRITE "${OUTPUT}" "${content}")
endif()
